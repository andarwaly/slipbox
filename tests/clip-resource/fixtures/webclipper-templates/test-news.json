{
  "schemaVersion": "0.1.0",
  "name": "test-news",
  "behavior": "create",
  "noteContentFormat": "# {{title}}\n\n{{content}}",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "resources",
  "triggers": ["https://example-news.com/some-story"],
  "properties": [
    { "name": "type", "value": "news", "type": "text" },
    { "name": "link", "value": "{{url}}", "type": "text" },
    { "name": "author", "value": "{{author}}", "type": "text" },
    { "name": "published", "value": "{{published|date:\"YYYY-MM-DD\"}}", "type": "date" },
    { "name": "publisher", "value": "{{meta:property:og:site_name}}", "type": "text" },
    { "name": "tags", "value": "", "type": "multitext" }
  ]
}
