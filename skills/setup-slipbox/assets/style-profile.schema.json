{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slipbox.local/schemas/style-profile.schema.json",
  "title": ".slipbox/style-profile.json",
  "description": "User-stated preferences for note shape, language, formatting, and editing. This is not a corpus-derived voice model.",
  "type": "object",
  "required": [
    "voice",
    "sentence_style",
    "tone_by_note",
    "language",
    "vocabulary",
    "formatting",
    "editing_style"
  ],
  "additionalProperties": false,
  "properties": {
    "voice": {
      "type": "object",
      "description": "The user's stated writing preferences, not an inferred voice fingerprint.",
      "required": ["overall", "verbosity", "confidence", "hedging", "energy"],
      "additionalProperties": false,
      "properties": {
        "overall": { "type": "string" },
        "verbosity": { "type": "string" },
        "confidence": { "type": "string" },
        "hedging": { "type": "string" },
        "energy": { "type": "string" }
      }
    },
    "sentence_style": {
      "type": "object",
      "description": "Preferences for the shape and cadence of generated notes.",
      "required": ["average_length", "structure", "prefers_lists", "paragraphs", "conclusion_first"],
      "additionalProperties": false,
      "properties": {
        "average_length": { "type": "string" },
        "structure": { "type": "string" },
        "prefers_lists": { "type": "boolean" },
        "paragraphs": { "type": "string" },
        "conclusion_first": { "type": "boolean" }
      }
    },
    "tone_by_note": {
      "type": "object",
      "description": "Tone preferences keyed by the note types configured in config.json's frontmatter map.",
      "additionalProperties": { "type": "string" }
    },
    "language": {
      "type": "object",
      "description": "Languages and terminology preferences stated by the user. Code-switching remains an open vocabulary until a later decision.",
      "required": ["primary", "secondary", "technical_terms", "code_switching"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "technical_terms": { "type": "string" },
        "code_switching": {
          "type": "string",
          "description": "Free string for now. A controlled vocabulary may be adopted later."
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "description": "Words and phrases the user says to prefer or avoid in notes.",
      "required": ["often_uses", "avoids"],
      "additionalProperties": false,
      "properties": {
        "often_uses": { "type": "array", "items": { "type": "string" } },
        "avoids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "formatting": {
      "type": "object",
      "description": "Preferred note-shape and markup conventions.",
      "required": ["bullet_heavy", "wikilinks", "aliases", "headings", "quotes", "citations"],
      "additionalProperties": false,
      "properties": {
        "bullet_heavy": { "type": "boolean" },
        "wikilinks": { "type": "string" },
        "aliases": { "type": "string" },
        "headings": { "type": "string" },
        "quotes": { "type": "string" },
        "citations": { "type": "string" },
        "blank_lines_between_blocks": {
          "type": "boolean",
          "description": "Whether saved notes use blank lines between adjacent Markdown blocks. Absent means preserve the legacy spaced format."
        }
      }
    },
    "editing_style": {
      "type": "object",
      "description": "Editing behaviors the note-writing skills should follow.",
      "required": ["iterative", "renames_often", "compresses_language", "removes_redundancy"],
      "additionalProperties": false,
      "properties": {
        "iterative": { "type": "boolean" },
        "renames_often": { "type": "boolean" },
        "compresses_language": { "type": "boolean" },
        "removes_redundancy": { "type": "boolean" }
      }
    }
  }
}
