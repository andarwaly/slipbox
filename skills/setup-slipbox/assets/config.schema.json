{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slipbox.local/schemas/config.schema.json",
  "title": ".slipbox/config.json",
  "type": "object",
  "required": ["paths", "filenames", "frontmatter", "links", "templates", "transcript_languages"],
  "additionalProperties": false,
  "properties": {
    "paths": {
      "type": "object",
      "required": ["resources", "literature", "evergreen", "term"],
      "additionalProperties": false,
      "properties": {
        "resources": { "type": "string" },
        "literature": { "type": "string" },
        "evergreen": { "type": "string" },
        "term": { "type": "string" }
      }
    },
    "filenames": {
      "type": "object",
      "required": ["literature", "term", "evergreen"],
      "additionalProperties": false,
      "properties": {
        "literature": { "$ref": "#/definitions/casing" },
        "term": { "$ref": "#/definitions/casing" },
        "evergreen": { "$ref": "#/definitions/casing" }
      }
    },
    "frontmatter": {
      "type": "object",
      "required": ["literature", "term", "evergreen"],
      "additionalProperties": false,
      "properties": {
        "literature": { "$ref": "#/definitions/field_map" },
        "term": { "$ref": "#/definitions/field_map" },
        "evergreen": { "$ref": "#/definitions/field_map" }
      }
    },
    "links": {
      "type": "object",
      "required": ["style"],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": ["wikilink", "markdown"]
        }
      }
    },
    "templates": {
      "type": "object",
      "required": [
        "literature_path",
        "term_path",
        "evergreen_path",
        "article_path",
        "news_path",
        "social_path",
        "video_path"
      ],
      "additionalProperties": false,
      "properties": {
        "literature_path": { "type": "string" },
        "term_path": { "type": "string" },
        "evergreen_path": { "type": "string" },
        "article_path": { "type": "string" },
        "news_path": { "type": "string" },
        "social_path": { "type": "string" },
        "video_path": { "type": "string" }
      }
    },
    "transcript_languages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "definitions": {
    "casing": {
      "type": "string",
      "enum": ["kebab-case", "Title Case", "snake_case", "verbatim", "other"]
    },
    "field_map": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "boolean", "const": false },
          {
            "type": "object",
            "required": ["name", "type", "zone"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["text", "list", "number", "checkbox", "date", "datetime"] },
              "wikilink": { "type": "boolean", "default": false },
              "zone": { "type": "string", "enum": ["top", "bottom"] }
            }
          }
        ]
      },
      "description": "Per required field, one of three forms: (a) a bare string — shorthand for {name: <string>, type: \"text\", wikilink: false, zone: \"top\"}, the existing user property it maps onto or the standard field name if newly created (zone defaults to \"top\" for this shorthand form); (b) false for explicit opt-out; (c) an object {name, type, wikilink, zone} giving full control — name is the existing or standard property name, type is Obsidian's own native Properties type (text/list/number/checkbox/date/datetime, i.e. Text/List/Number/Checkbox/Date/Date & Time), wikilink (default false) marks whether the value(s) get wrapped per the sibling top-level links.style field, and zone (required, \"top\" or \"bottom\") places a newly-created field at the top or bottom of the frontmatter block — only meaningful for fields being newly created, since a field mapped onto an existing user property stays wherever that property already sits in the user's template. Never a key equal to the reserved properties tags, aliases, or cssclasses."
    }
  }
}
