{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slipbox.local/schemas/stated-style.schema.json",
  "title": ".slipbox/stated_style.json",
  "type": "object",
  "required": ["person", "pacing", "register", "tone", "language", "forbidden_vocabulary"],
  "additionalProperties": false,
  "properties": {
    "person": {
      "type": "string",
      "enum": ["first", "third"],
      "description": "First person or third person."
    },
    "pacing": {
      "type": "string",
      "enum": ["terse", "exploratory"]
    },
    "register": {
      "type": "string",
      "enum": ["technical", "conversational"]
    },
    "tone": {
      "type": "object",
      "description": "Score on NN/g's four tone-of-voice axes: funny-serious, formal-casual, respectful-irreverent, matter-of-fact-enthusiastic.",
      "required": [
        "funny_serious",
        "formal_casual",
        "respectful_irreverent",
        "matter_of_fact_enthusiastic"
      ],
      "additionalProperties": false,
      "properties": {
        "funny_serious": { "$ref": "#/definitions/funny_serious" },
        "formal_casual": { "$ref": "#/definitions/formal_casual" },
        "respectful_irreverent": { "$ref": "#/definitions/respectful_irreverent" },
        "matter_of_fact_enthusiastic": { "$ref": "#/definitions/matter_of_fact_enthusiastic" }
      }
    },
    "language": {
      "type": "object",
      "description": "Primary/additional languages the user says they write in and their code-switching behavior, stated directly (no corpus to detect it from).",
      "required": ["primary", "additional", "code_switching"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "description": "Language code, e.g. en."
        },
        "additional": {
          "type": "array",
          "items": { "type": "string" }
        },
        "code_switching": {
          "type": "string",
          "enum": ["none", "register-gated", "free-mixing"]
        }
      }
    },
    "forbidden_vocabulary": {
      "type": "array",
      "description": "Words/phrases the user explicitly says they never want to see in their notes. Empty list is a valid answer.",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "funny_serious": {
      "type": "string",
      "enum": ["very-funny", "somewhat-funny", "somewhat-serious", "very-serious"]
    },
    "formal_casual": {
      "type": "string",
      "enum": ["very-formal", "somewhat-formal", "somewhat-casual", "very-casual"]
    },
    "respectful_irreverent": {
      "type": "string",
      "enum": ["very-respectful", "somewhat-respectful", "somewhat-irreverent", "very-irreverent"]
    },
    "matter_of_fact_enthusiastic": {
      "type": "string",
      "enum": [
        "matter-of-fact",
        "somewhat-matter-of-fact",
        "somewhat-enthusiastic",
        "very-enthusiastic"
      ]
    }
  }
}
